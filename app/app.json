{
  "name": "Lista do Churras",
  "slug": "lista-do-churras",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "light",
  "owner": "dandf",
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.listadochurras.app"
  },
  "android": {
    "package": "com.listadochurras.app",
    "versionCode": 1,
    "adaptiveIcon": {
      "backgroundColor": "#F3EEE6",
      "backgroundImage": "./assets/android-icon-background.png",
      "foregroundImage": "./assets/android-icon-foreground.png",
      "monochromeImage": "./assets/android-icon-monochrome.png"
    },
    "predictiveBackGestureEnabled": false
  },
  "web": {
    "favicon": "./assets/favicon.png",
    "bundler": "metro",
    "output": "single"
  },
  "plugins": [
    [
      "expo-splash-screen",
      {
        "backgroundColor": "#F3EEE6",
        "image": "./assets/splash-icon.png",
        "imageWidth": 200
      }
    ],
    "expo-secure-store",
    [
      "expo-build-properties",
      {
        "android": {
          "kotlinVersion": "2.3.20",
          "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
        }
      }
    ],
    [
      "./plugins/withKotlinGradlePlugin",
      {
        "kotlinVersion": "2.3.20"
      }
    ],
    "expo-iap",
    [
      "react-native-google-mobile-ads",
      {
        "androidAppId": "ca-app-pub-3940256099942544~3347511713",
        "iosAppId": "ca-app-pub-3940256099942544~1458002511"
      }
    ]
  ],
  "extra": {
    "iapProductId": "lista_sem_anuncio",
    "admobBannerUnitId": "",
    "adsUseTestUnits": true,
    "eas": {
      "projectId": "3e4a9a0c-d076-4c69-8ae9-328888a850ef"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
